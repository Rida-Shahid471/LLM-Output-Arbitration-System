APP_ENV=development
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# Optional per-critic provider/model overrides for experiments.
FACTUAL_PROVIDER=
FACTUAL_MODEL=
LOGICAL_PROVIDER=
LOGICAL_MODEL=
COMPLETENESS_PROVIDER=
COMPLETENESS_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Applied to OpenAI/Ollama clients. Anthropic requests omit temperature.
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
MAX_PROVIDER_INPUT_CHARS=100000
OPENAI_MAX_INPUT_CHARS=100000
ANTHROPIC_MAX_INPUT_CHARS=100000
OLLAMA_MAX_INPUT_CHARS=100000
OPENAI_MAX_OUTPUT_TOKENS=2048
ANTHROPIC_MAX_OUTPUT_TOKENS=2048
OLLAMA_MAX_OUTPUT_TOKENS=2048

FACTUAL_THRESHOLD=3
LOGICAL_THRESHOLD=3
COMPLETENESS_THRESHOLD=3

LOG_LEVEL=INFO

MAX_PROMPT_CHARS=20000
MAX_ANSWER_CHARS=50000
MAX_BATCH_SIZE=2
DATABASE_PATH=data/arbitrations.sqlite3
OLLAMA_BASE_URL=http://localhost:11434/v1
# Docker Compose uses this separate host URL so the copied local setting above
# cannot accidentally point the container back at itself.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
